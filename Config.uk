menuconfig PLAT_RASPI
       bool "Raspberry Pi 3B"
       default n
       depends on ARCH_ARM_64
       help
          Create a Unikraft image that runs as a Raspberry Pi 3B

if (PLAT_RASPI)

menu "Console Options"
config RASPI_PRINTF_SERIAL_CONSOLE
        bool "Serial console for printf"
        default y
        depends on ARCH_ARM_64
        help
          Choose serial console for printf

config RASPI_KERNEL_SERIAL_CONSOLE
        bool "Serial console for the kernel prints"
        default n
        depends on ARCH_ARM_64
        help
          Choose serial console for the kernel printing

config RASPI_DEBUG_SERIAL_CONSOLE
        bool "Serial console for the debug prints"
        default n
        depends on ARCH_ARM_64
        help
          Choose serial console for the debug printing
endmenu

menu "Profiling"
config RASPI_WATERMARK_STACK
       bool "Watermark Stack"
       default n
       depends on ARCH_ARM_64
endmenu

menu "Interrupt Controller Settings"
config LIBUKINTCTLR_MAX_HANDLERS_PER_IRQ
	int "Max number of interrupt handlers per IRQ"
	default 1
	help
	  Define the number of handlers supported per IRQ line.
endmenu

menu "Driver Options"
config LIBBCM2835_SPI
        bool "BCM2835/7 SPI0 driver (Raspberry Pi 3)"
        default y
        depends on ARCH_ARM_64
        help
          Polled-mode driver for the BCM2835/BCM2837 SPI0 controller as
          found on the Raspberry Pi 3 Model B.  Provides bcm2835_spi_init(),
          bcm2835_spi_transfer(), and bcm2835_spi_set_clock().

          Derived from FreeBSD sys/arm/broadcom/bcm2835/bcm2835_spi.c.
          Uses interrupt-free polled transfers so it is safe to call during
          early platform initialisation before the IRQ subsystem is up.

config LIBBCM2835_GPIO
        bool "BCM2835/7 GPIO driver (FreeBSD shim, Raspberry Pi 3)"
        default n
        depends on ARCH_ARM_64
        help
          GPIO driver using the unmodified FreeBSD bcm2835_gpio.c driver
          via a minimal KOBJ shim layer.  No edits to the FreeBSD source
          are required: bcm_gpio_probe and bcm_gpio_attach remain static;
          the KOBJ constructor/dispatch mechanism finds them at runtime.

          Exposes uk_gpio_init(), uk_gpio_set(), uk_gpio_get(),
          uk_gpio_set_func(), and uk_gpio_set_pud() to applications.
endmenu

endif
